{
  "manifest_version": 3,
  "name": "Biblioteca Ads Pro",
  "short_name": "Ads Pro",
  "version": "1.4.0",
  "description": "Filtrá la Biblioteca de anuncios de Meta por destino (perfil, mensaje, web), días activo y formato. Descargá y transcribí videos, guardá anuncios y exportá a Excel.",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "downloads",
    "activeTab",
    "offscreen"
  ],
  "host_permissions": [
    "https://*.fbcdn.net/*",
    "https://api.openai.com/*",
    "https://api.groq.com/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "action": {
    "default_title": "Biblioteca Ads Pro",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.facebook.com/ads/library*"
      ],
      "js": [
        "src/inject/hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://*.facebook.com/ads/library*"
      ],
      "js": [
        "src/shared/core.js",
        "src/shared/export.js",
        "src/shared/settings.js",
        "src/shared/card.js",
        "src/content/content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/shared/ui.css",
        "src/content/panel.css"
      ],
      "matches": [
        "https://*.facebook.com/*"
      ]
    }
  ],
  "minimum_chrome_version": "116",
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "options_ui": {
    "page": "src/pages/options.html",
    "open_in_tab": true
  }
}
